# dockerhub-keepalive 环境变量样例
# 用法：复制本文件为项目根目录 .env，再 docker compose up -d
# 生成主密钥：openssl rand -hex 32
# （.env 含敏感信息，请勿提交到版本库；本项目 .dockerignore/.gitignore 已排除）

# ===== 必填 =====
# 主密钥：AES-256-GCM 加密通知凭证/TOTP 密钥；缺失则服务拒绝启动（fail-fast）
APP_SECRET_KEY=请替换为_openssl_rand_-hex_32_的输出

# ===== 可选（不填使用默认值）=====

# 监听/映射端口（容器内与宿主一致；healthcheck 自动适配）
WEB_PORT=8080

# cron 任务时区（默认 UTC；建议 Asia/Shanghai）
TZ=Asia/Shanghai

# 反向代理场景（如 Cloudflare Access 前置）置 1：信任 X-Forwarded-For 取真实来源 IP
TRUST_PROXY=0

# HTTPS 反向代理场景置 1：会话 Cookie 加 Secure 标志
COOKIE_SECURE=0

# 登录失败阈值与锁定分钟数（防暴力破解）
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15

# 会话有效期（天）
SESSION_TTL_DAYS=30

# 用户名扫描仓库上限（0=不限）；单仓库拉取 tag 上限（0=全部）
MAX_REPOS_SCAN=50
MAX_TAGS_PER_REPO=20

# pull/rmi 与通知失败重试次数
PULL_RETRIES=3
NOTIFY_RETRIES=3

# 空间预检余量系数（可用空间 ≥ 估算容量 × 该值）
SPACE_HEADROOM=1.1
